# Copy to .env and edit — or run `make init`, which also generates RCON_PASSWORD.

EULA=TRUE
TZ=Europe/Kyiv
PUID=1000
PGID=1000

# ─── Version ───
MC_VERSION=1.21.1
NEOFORGE_VERSION=21.1.248

# ─── Memory ───
INIT_MEMORY=8G
MAX_MEMORY=8G
MEM_LIMIT=10G

# ─── Network ───
SERVER_PORT=25565
# Simple Voice Chat, UDP. Change it here and in the mod's server config together.
VOICE_PORT=24454
RCON_PORT=25575
RCON_BIND=127.0.0.1
# Generate: openssl rand -base64 24
RCON_PASSWORD=

# ─── Gameplay ───
# Two lines, split on \n. § starts a colour code: 6 gold, a green, b aqua,
# d pink, f white, 7 grey, 8 dark grey, l bold. Keep each line under ~45
# characters or the server list truncates it.
MOTD=§6§lSACRIFICED §8» §fCreate §71.21.1\n§aVoice Chat §8· §bLive Map §8· §dNo Licence Needed
DIFFICULTY=hard
GAMEMODE=survival
MAX_PLAYERS=10
VIEW_DISTANCE=16
SIMULATION_DISTANCE=10
PVP=TRUE
# FALSE lets unlicensed clients join. The server then cannot verify anyone, so
# the whitelist becomes a list of names rather than accounts: whoever knows a
# whitelisted name can join as that player. Keep ENFORCE_WHITELIST=TRUE, and
# treat operator names as secrets. Switching also changes every player's UUID.
ONLINE_MODE=FALSE
ALLOW_FLIGHT=FALSE
SPAWN_PROTECTION=16
LEVEL_NAME=world
SEED=sacrificed

# ─── Access ───
# Comma-separated nicknames
OPS=sacrificed666
WHITELIST=sacrificed666
ENFORCE_WHITELIST=TRUE

# ─── Stability ───
# Watchdog ms; -1 disables it for slow modded worldgen
MAX_TICK_TIME=60000

# ─── Domains ───
# All three are A records pointing at this host. Only admin and map go through
# Traefik; Minecraft itself is raw TCP on SERVER_PORT, so SERVER_HOST is DNS only.
SERVER_HOST=server.sacrificed.me
ADMIN_HOST=admin.sacrificed.me
MAP_HOST=map.sacrificed.me
ACME_EMAIL=you@sacrificed.me

# ─── Admin panel ───
# The bootstrap admin. Works even when the database is down.
ADMIN_USERNAME=sacrificed666
# Generated by `make init`
ADMIN_PASSWORD=
SESSION_SECRET=
# Host docker group, for the CPU/memory tiles: stat -c '%g' /var/run/docker.sock
DOCKER_GID=988
# Local ports. Production reaches both through Traefik, so keep them on
# loopback; they exist for SSH tunnels and debugging.
ADMIN_BIND=127.0.0.1
ADMIN_PORT=3000
MAP_BIND=127.0.0.1
MAP_PORT=8100

# ─── User database ───
# Postgres 18, reachable only on the internal network. The password is
# generated by `make init`; changing it later needs the volume recreated.
POSTGRES_DB=admin
POSTGRES_USER=admin
POSTGRES_PASSWORD=

# ─── Modpack ───
# Built by `make modpack` into server/modpack/, served from the admin panel.
# Which jars are server-only lives in server/server-only-mods.txt.

# ─── Backups ───
# Cron, in the container's timezone (TZ above). Default: midnight, every day.
BACKUP_CRON=0 0 * * *
PRUNE_BACKUPS_DAYS=3

# ─── Map rendering ───
# BlueMap competes with the server tick, so the maps stay frozen through the day
# and render in one window at night. That window is a host crontab, installed by
# Ansible — retune it in ansible/roles/minecraft/defaults/main.yml, or render on
# demand with `make map-render`.
