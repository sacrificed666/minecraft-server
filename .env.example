# Copy to .env and edit — or run `make init`, which also generates RCON_PASSWORD.

EULA=TRUE
TZ=Europe/Kyiv
PUID=1000
PGID=1000

# ─── Version ───
MC_VERSION=1.21.1
NEOFORGE_VERSION=21.1.248

# ─── Memory ───
INIT_MEMORY=8G
MAX_MEMORY=8G
MEM_LIMIT=10G

# ─── Network ───
SERVER_PORT=25565
# Simple Voice Chat, UDP. Change it here and in the mod's server config together.
VOICE_PORT=24454
RCON_PORT=25575
RCON_BIND=127.0.0.1
# Generate: openssl rand -base64 24
RCON_PASSWORD=

# ─── Gameplay ───
# Two lines, split on \n.
MOTD=§6§lsacrificed §8» §fCreate §71.21.1\n§aVoice Chat §8· §bLive Map §8· §dNo Licence Needed
DIFFICULTY=hard
GAMEMODE=survival
MAX_PLAYERS=10
VIEW_DISTANCE=12
SIMULATION_DISTANCE=6
PVP=TRUE
# 0 means one sleeper skips the night; above 100 disables it entirely.
SLEEP_PERCENTAGE=0
# FALSE lets unlicensed clients join.
ONLINE_MODE=FALSE
ALLOW_FLIGHT=FALSE
SPAWN_PROTECTION=16
LEVEL_NAME=world
SEED=sacrificed

# ─── Access ───
# Comma-separated nicknames
OPS=sacrificed666
ENFORCE_WHITELIST=TRUE

# ─── Stability ───
# Watchdog ms; -1 disables it for slow modded worldgen
MAX_TICK_TIME=60000

# ─── Domains ───
# All three are A records pointing at this host.
SERVER_HOST=server.sacrificed.me
ADMIN_HOST=admin.sacrificed.me
MAP_HOST=map.sacrificed.me
ACME_EMAIL=you@sacrificed.me

# ─── Admin panel ───
# The bootstrap admin. Works even when the database is down.
ADMIN_USERNAME=sacrificed666
# Generated by `make init`
ADMIN_PASSWORD=
SESSION_SECRET=
# Local ports.
ADMIN_BIND=127.0.0.1
ADMIN_PORT=3000
MAP_BIND=127.0.0.1
MAP_PORT=8100

# ─── User database ───
# Postgres 18, reachable only on the internal network.
POSTGRES_DB=admin
POSTGRES_USER=admin
POSTGRES_PASSWORD=

# ─── Backups ───
# Cron, in the container's timezone (TZ above). Default: midnight, every day.
BACKUP_CRON=0 0 * * *
PRUNE_BACKUPS_DAYS=3
